# Mẫu env — copy sang .env rồi điền giá trị thật. .env KHÔNG được commit.
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=banking

DEBEZIUM_PASSWORD=change-me

TXN_RATE=20
RANDOM_SEED=42

# MinIO — object store nói giao thức S3. Cũng chính là AWS credential mà Spark/
# Iceberg dùng (S3FileIO), nên Phần 2 chỉ đổi endpoint + key thật là lên S3 được.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars
