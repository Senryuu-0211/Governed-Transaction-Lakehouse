# Mẫu env — copy sang `.env` rồi điền giá trị thật. `.env` KHÔNG được commit.
#
#     cp .env.example .env && $EDITOR .env
#
# File này cũng là thứ CI dùng để `docker compose config`: thiếu một khoá nào ở
# đây là CI đỏ. Nhờ vậy nó không thể lặng lẽ lạc hậu so với compose — đã từng lạc
# hậu HAI lần và cả hai đều khiến người clone repo về không dựng nổi stack:
#   01-08 còn khai MinIO sau khi MinIO bị bỏ (CI bắt được)
#   06-08 thiếu 4 khoá dual-mode sau khi MinIO quay lại (CI KHÔNG bắt được, vì
#         compose có giá trị mặc định — bài học: default che mất lỗi tài liệu)

# --- Postgres nguồn (OLTP mô phỏng core banking) -----------------------------
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me
POSTGRES_DB=banking

# Role riêng cho Debezium: chỉ REPLICATION + SELECT, không phải superuser.
# CDC đọc được toàn bộ WAL nên đây là tài khoản đáng để least-privilege.
DEBEZIUM_PASSWORD=change-me

# --- Faker sinh giao dịch ----------------------------------------------------
TXN_RATE=20        # giao dịch/giây
RANDOM_SEED=42     # cố định để tái lập được kết quả khi debug

# --- KHO LAKEHOUSE: HAI CHẾ ĐỘ, chọn bằng S3_ENDPOINT ------------------------
#
#   S3_ENDPOINT có giá trị  -> MinIO ở localhost  (PHẦN 1, $0)   <- mặc định dưới đây
#   S3_ENDPOINT để TRỐNG    -> AWS S3 thật        (PHẦN 2)
#
# KHÔNG có nhánh `if` nào trong code job: Spark, dbt và các script ops đều đi qua
# Iceberg S3FileIO + một helper boto3 duy nhất (`gtl_session.s3_client()`).
# Đã kiểm chứng CẢ HAI CHIỀU: MinIO->S3 (30-07, 82 PASS) và S3->MinIO (06-08, 91 PASS),
# không sửa một dòng model nào.
#
# ⚠️ Credential CHỈ ở file này. KHÔNG truyền qua `--conf` của Spark: Spark đưa mọi
# conf vào dòng lệnh JVM nên `ps aux` sẽ in secret ra chữ thô (sự cố 01-08).

# --- CHẾ ĐỘ A: MinIO (mặc định, dùng cho PHẦN 1) ---
S3_ENDPOINT=http://localhost:9001       # Spark chạy ở HOST nên trỏ localhost
CATALOG_S3_ENDPOINT=http://minio:9000   # iceberg-rest chạy TRONG mạng docker
S3_PATH_STYLE=true                      # MinIO cần path-style, AWS thì không
S3_BUCKET=gtl-lakehouse
STORAGE_QUOTA=300gb                     # hạn mức CỨNG — MinIO từ chối ghi khi vượt.
                                        # Có vì sự cố 28-07: small-files ăn hết 397GB
                                        # làm chết cả server. Thiện chí không chặn được.
AWS_ACCESS_KEY_ID=gtl-local-admin       # với MinIO đây chỉ là user cục bộ, không phải AWS
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1            # MinIO không dùng nhưng SDK vẫn đòi

# --- CHẾ ĐỘ B: AWS S3 thật (PHẦN 2) ---
# Bỏ comment khối dưới, XOÁ 3 dòng S3_ENDPOINT/CATALOG_S3_ENDPOINT/S3_PATH_STYLE ở trên,
# rồi comment 2 service `minio` và `minio-init` trong docker-compose.yml.
# ⚠️ TIỀN THẬT. Dùng IAM user least-privilege chỉ có quyền trên ĐÚNG một bucket
# (xem terraform/iam.tf) và bật Budget alert TRƯỚC khi chạy: mỗi file ghi ra là một
# PUT tính phí, nên small-files problem ở đây không chỉ chậm mà là đốt ví.
#
# S3_ENDPOINT=
# CATALOG_S3_ENDPOINT=
# S3_PATH_STYLE=false
# S3_BUCKET=change-me-bucket-name
# STORAGE_QUOTA=300gb
# AWS_ACCESS_KEY_ID=change-me
# AWS_SECRET_ACCESS_KEY=change-me
# AWS_DEFAULT_REGION=us-east-1

# --- Superset (BI cho người dùng nghiệp vụ) ----------------------------------
SUPERSET_SECRET_KEY=change-me-long-random-string
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_META_PASSWORD=change-me

# Tài khoản CHỈ ĐỌC cho Superset truy vấn các bảng mart. Dashboard không có lý do
# gì cần quyền ghi — và đây là tài khoản mà nhiều người dùng chung.
MARTS_RO_PASSWORD=change-me
